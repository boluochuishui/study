<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring 单例依赖由容器管理，不属于对外暴露的可变领域状态。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="objectMapper"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="kafkaTemplate"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="mapper"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="service"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="dataService"/>
    </Match>

    <!-- 构造失败由 Spring 启动过程处理，相关 Bean 不定义 finalizer。 -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Spring ConfigurationProperties 依赖可变 JavaBean 完成配置绑定。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="org.example.study.baseSdk.concurrent.ThreadPoolProperties"/>
    </Match>
</FindBugsFilter>
