<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring 单例依赖由容器管理，不属于对外暴露的可变领域状态。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="objectMapper"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="kafkaTemplate"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="mapper"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="service"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="dataService"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="redisTemplate"/>
    </Match>

    <!-- 构造失败由 Spring 启动过程处理，相关 Bean 不定义 finalizer。 -->
    <!-- Kafka 注册表由 Spring 管理，生命周期适配器需要共享同一个容器集合。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="org.example.study.worker.lifecycle.KafkaLifecycleParticipant"/>
        <Field name="registry"/>
    </Match>

    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Spring ConfigurationProperties 依赖可变 JavaBean 完成配置绑定。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="org.example.study.baseSdk.concurrent.ThreadPoolProperties"/>
    </Match>
    <!-- Spring 管理的共享存储与配置 Bean 是基础设施依赖，不能做防御复制。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="org.example.study.worker.ModalityWorkerService"/>
        <Field name="fileStore"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="org.example.study.application.BatchRequestPreparer"/>
        <Field name="store"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="org.example.study.application.BatchRequestPreparer"/>
        <Field name="limits"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="org.example.study.application.UploadedMediaValidator"/>
        <Field name="limits"/>
    </Match>
</FindBugsFilter>
